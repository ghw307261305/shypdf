---
import Base from '@/layouts/Base.astro';
import ToolCard from '@/components/ToolCard.astro';
import AdSlot from '@/components/AdSlot.astro';
import { SITE } from '@/config/site';
import { toolsByCategory, type Category } from '@/data/tools';
import { GUIDES } from '@/data/guides';
import { DEFAULT_LOCALE, LOCALE_INFO, getDict, fmt, localePath, localeStaticPaths, type Locale } from '@/i18n';

export const getStaticPaths = localeStaticPaths;
const { locale } = Astro.props as { locale: Locale };
const d = getDict(locale);
const h = d.ui.home;
const order: Category[] = ['edit', 'convert', 'optimize', 'security'];
const all = order.flatMap((c) => toolsByCategory(c, locale));
const enNames = new Map(order.flatMap((c) => toolsByCategory(c, DEFAULT_LOCALE)).map((t) => [t.slug, t.name]));
// 单页分组：按分类各起一节（标题可作 /#convert 锚点），占位工具仍集中在「Coming soon」
const groups = [
  ...order.map((c) => ({ key: c, name: d.ui.categories[c], note: c === order[0] ? h.liveNote : undefined, tools: all.filter((t) => t.category === c && t.phase === 1) })),
  { key: 'soon', name: h.soonName, note: h.soonNote, tools: all.filter((t) => t.phase !== 1) },
].filter((g) => g.tools.length);
const jsonLd = { '@context': 'https://schema.org', '@type': 'WebSite', name: SITE.name, url: new URL(localePath(locale), SITE.url).href, description: d.site.description, inLanguage: LOCALE_INFO[locale].htmlLang };
const check = '<path d="M5 12l5 5 9-10"/>';
---
<Base title={fmt(h.title, { site: SITE.name })} current="home" jsonLd={jsonLd} locale={locale}>
  <section class="hero">
    <div class="wrap">
      <h1>{d.site.tagline}</h1>
      <p>{d.site.description}</p>
      <div class="search">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
        <label for="q" class="sr-only">{h.searchLabel}</label>
        <input id="q" type="search" placeholder={h.searchPlaceholder} autocomplete="off" />
      </div>
      <ul class="badges">
        {h.badges.map((b) => (
          <li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={check} />{b}</li>
        ))}
      </ul>
    </div>
  </section>

  <div class="wrap">
    {groups.map((g) => (
      <section class="section" id={g.key} data-group={g.key}>
        <div class="section-head"><h2>{g.name}</h2>{g.note && <span>{g.note}</span>}</div>
        <div class="tool-grid">{g.tools.map((t) => <ToolCard tool={t} locale={locale} enName={locale === DEFAULT_LOCALE ? undefined : enNames.get(t.slug)} />)}</div>
      </section>
    ))}
    <p id="no-result" class="is-hidden" style="padding:32px 0;color:var(--muted)">{h.noResult}</p>

    {/* 指南目前只有英文版 */}
    {locale === DEFAULT_LOCALE && (
      <section class="section">
        <div class="section-head"><h2>{h.guides}</h2><span><a href="/guides/">{h.seeAll}</a></span></div>
        <div class="home-guides">{GUIDES.slice(0, 4).map((g) => <a href={`/guides/${g.slug}/`}><b>{g.title}</b><small>{g.description}</small></a>)}</div>
      </section>
    )}

    <section class="pitch">
      {h.pitch.map((x) => <div><b>{x.title}</b><p>{x.body}</p></div>)}
    </section>
    <div style="margin-top:48px;display:flex;justify-content:center"><AdSlot width={970} height={90} label={d.ui.adLabel} /></div>
  </div>

  <script>
    // 首页搜索：按名称（含英文名）/简介过滤卡片，隐藏空分组
    const q = document.getElementById('q') as HTMLInputElement;
    const cards = Array.from(document.querySelectorAll<HTMLElement>('.tool-card'));
    const sections = Array.from(document.querySelectorAll<HTMLElement>('.section[data-group]'));
    const empty = document.getElementById('no-result')!;
    q.addEventListener('input', () => {
      const s = q.value.trim().toLowerCase();
      let any = false;
      for (const c of cards) {
        const hit = !s || (c.dataset.name + ' ' + (c.dataset.en || '') + ' ' + c.dataset.short + ' ' + (c.getAttribute('href') || '')).toLowerCase().includes(s);
        c.classList.toggle('is-hidden', !hit);
        if (hit) any = true;
      }
      for (const sec of sections) {
        const visible = sec.querySelectorAll('.tool-card:not(.is-hidden)').length > 0;
        sec.classList.toggle('is-hidden', !visible);
      }
      empty.classList.toggle('is-hidden', any);
    });
  </script>
</Base>
