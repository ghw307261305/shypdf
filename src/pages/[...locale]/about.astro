---
import Base from '@/layouts/Base.astro';
import { SITE } from '@/config/site';
import { getDict, fmt, localeStaticPaths, type Locale } from '@/i18n';

export const getStaticPaths = localeStaticPaths;
const { locale } = Astro.props as { locale: Locale };
const a = getDict(locale).ui.about;
const site = { site: SITE.name };
// howBody 里的 {link} 换成指向开源许可页（只有英文版）的链接
const [howBefore, howAfter = ''] = a.howBody.split('{link}');
const [sourceBefore, sourceAfter = ''] = a.sourceBody.split('{link}');
---
<Base title={fmt(a.title, site)} description={fmt(a.description, site)} locale={locale}>
  <div class="wrap prose">
    <h1>{fmt(a.heading, site)}</h1>
    <p>{fmt(a.intro, site)}</p>
    <h2>{a.whyTitle}</h2>
    <p>{a.whyBody}</p>
    <h2>{a.howTitle}</h2>
    <p>{howBefore}<a href="/licenses/">{a.howLink}</a>{howAfter}</p>
    {SITE.repo.live && (<>
      <h2>{a.sourceTitle}</h2>
      <p>{sourceBefore}<a href={SITE.repo.url} rel="noopener">{fmt(a.sourceLink, site)}</a>{sourceAfter}</p>
    </>)}
    <h2>{a.contactTitle}</h2>
    <p>{a.contactBody} <a href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a></p>
  </div>
</Base>
