---
// 指南文章的公共外壳：标题、日期、Article 结构化数据、文末的工具入口。
import Base from '@/layouts/Base.astro';
import { SITE } from '@/config/site';
import { guideBySlug } from '@/data/guides';
import { toolBySlug } from '@/data/tools';

interface Props { slug: string }
const guide = guideBySlug(Astro.props.slug)!;
const url = new URL(`/guides/${guide.slug}/`, SITE.url).href;
const tools = guide.tools.map(toolBySlug).filter((t) => t && t.phase === 1);
const fmt = (iso: string) => new Date(iso + 'T00:00:00Z').toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Article', headline: guide.title, description: guide.description, datePublished: guide.published, dateModified: guide.updated ?? guide.published,
      mainEntityOfPage: url, image: new URL('/og.png', SITE.url).href,
      author: { '@type': 'Organization', name: SITE.name, url: SITE.url }, publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url } },
    { '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: SITE.name, item: new URL('/', SITE.url).href },
      { '@type': 'ListItem', position: 2, name: 'Guides', item: new URL('/guides/', SITE.url).href },
      { '@type': 'ListItem', position: 3, name: guide.title, item: url },
    ] },
  ],
};
---
<Base title={guide.title} description={guide.description} jsonLd={jsonLd}>
  <article class="wrap prose guide">
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> › <a href="/guides/">Guides</a></nav>
    <h1>{guide.title}</h1>
    <p class="guide-meta">{guide.updated ? `Updated ${fmt(guide.updated)}` : fmt(guide.published)}</p>
    <slot />
    <aside class="guide-cta">
      <b>Tools mentioned in this guide</b>
      <div class="chips">{tools.map((t) => <a href={`/${t!.slug}/`}>{t!.name}</a>)}</div>
      <p>All of them run in your browser. Your files are never uploaded.</p>
    </aside>
  </article>
</Base>
