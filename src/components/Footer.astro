---
import { SITE } from '@/config/site';
import { liveTools } from '@/data/tools';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <nav class="wrap footer-tools" aria-label="All tools">
    <b>PDF tools</b>
    {liveTools().map((t) => <a href={`/${t.slug}/`}>{t.name}</a>)}
  </nav>
  <div class="wrap">
    <div>© {year} {SITE.name}<a href="/guides/" style="margin-left:14px">Guides</a><a href="/about/">About</a><a href="/privacy/">Privacy</a><a href="/terms/">Terms</a><a href="/licenses/">Open source</a></div>
    <div>Your files never leave your device</div>
  </div>
</footer>
